{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Ruida Script",
  "scopeName": "source.rpascript",
  "patterns": [
    {
      "include": "#verified"
    },
    {
      "match": "\\\\#[0-9a-fA-F]{6}",
      "name": "constant.other.color.rpascript"
    },
    {
      "match": "#[^\\n]*",
      "name": "comment.line.number-sign.rpascript"
    },
    {
      "begin": "\"\"\"",
      "end": "\"\"\"",
      "name": "comment.block.rpascript"
    },
    {
      "match": "^\\s*(session|server|new_packet)\\b",
      "name": "keyword.control.rpascript"
    },
    {
      "match": "\\bEOF\\b",
      "name": "keyword.control.rpascript"
    },
    {
      "match": "^\\s*(?:(CORE|MOVE|LASER|CONFIG|QUERY|ENGRAVE|CUT|FILE|SYSTEM)\\s+)?(?:(CMD)\\s+)?([A-Z][A-Z0-9_]*)\\b",
      "captures": {
        "1": {
          "name": "storage.type.rpascript"
        },
        "2": {
          "name": "keyword.other.rpascript"
        },
        "3": {
          "name": "support.function.rpascript"
        }
      }
    },
    {
      "match": "\\b[A-Za-z][A-Za-z0-9_]*\\s*[:=]",
      "name": "variable.parameter.rpascript"
    },
    {
      "match": "\\b\\d{1,3}(?:\\.\\d{1,3}){3}\\b",
      "name": "constant.numeric.rpascript"
    },
    {
      "match": "\\b\\d+(?:\\.\\d+)?(?:%|(?:mm/S|mm/s|MM/S|MM|mm|KHz|kHz|khz|mS|MS|ms|s)?\\b)",
      "name": "constant.numeric.rpascript"
    },
    {
      "match": "\\b0x[0-9a-fA-F]+\\b",
      "name": "constant.numeric.hex.rpascript"
    },
    {
      "match": "\\bMACHINE_STATUS_[A-Z0-9_]+\\b",
      "name": "constant.language.rpascript"
    },
    {
      "match": "\\b(MACHINE|CURRENT|ABSOLUTE|SET_POINT)\\b",
      "name": "constant.language.rpascript"
    }
  ],
  "repository": {
    "verified": {
      "comment": "Verified MT/CT mnemonics render green; lists 114 verified mnemonics",
      "match": "\\b(?:AIR_ASSIST_OFF|AIR_ASSIST_ON|ARRAY_END|BLOCK_END|CUT_FAR_XY|CUT_SPEED_LASER_1|END_JOB|EOF|FOCUS_Z|JOB_BOTTOM_LEFT|JOB_TOP_RIGHT|LAST_LAYER|LAYER_BOTTOM_LEFT|LAYER_COLOR|LAYER_FREQUENCY|LAYER_MAX_POWER_1|LAYER_MIN_POWER_1|LAYER_TOP_RIGHT|MEM_ACC_G0_RATIO|MEM_ACC_RATIO|MEM_AIR_PROTECT_CONFIG|MEM_AXIS_BACKLASH_1|MEM_AXIS_BACKLASH_2|MEM_AXIS_BTN_ACC_1|MEM_AXIS_BTN_ACC_2|MEM_AXIS_BTN_ACC_3|MEM_AXIS_BTN_ACC_4|MEM_AXIS_BTN_START_VEL_1|MEM_AXIS_BTN_START_VEL_2|MEM_AXIS_BTN_START_VEL_3|MEM_AXIS_BTN_START_VEL_4|MEM_AXIS_CONTROL_PARA_1|MEM_AXIS_CONTROL_PARA_2|MEM_AXIS_CONTROL_PARA_3|MEM_AXIS_CONTROL_PARA_4|MEM_AXIS_ESTP_ACC_1|MEM_AXIS_ESTP_ACC_2|MEM_AXIS_ESTP_ACC_3|MEM_AXIS_ESTP_ACC_4|MEM_AXIS_HOME_OFFSET_1|MEM_AXIS_HOME_OFFSET_2|MEM_AXIS_HOME_OFFSET_3|MEM_AXIS_HOME_OFFSET_4|MEM_AXIS_MAX_ACC_1|MEM_AXIS_MAX_ACC_2|MEM_AXIS_MAX_ACC_3|MEM_AXIS_MAX_ACC_4|MEM_AXIS_MAX_VELOCITY_1|MEM_AXIS_MAX_VELOCITY_2|MEM_AXIS_MAX_VELOCITY_3|MEM_AXIS_MAX_VELOCITY_4|MEM_AXIS_PRECISION_1|MEM_AXIS_PRECISION_2|MEM_AXIS_PRECISION_3|MEM_AXIS_PRECISION_4|MEM_AXIS_RANGE_3|MEM_AXIS_RANGE_4|MEM_AXIS_START_VELOCITY_1|MEM_AXIS_START_VELOCITY_2|MEM_AXIS_START_VELOCITY_3|MEM_AXIS_START_VELOCITY_4|MEM_BED_SIZE_X|MEM_BED_SIZE_Y|MEM_ENG_ACC_RATIO|MEM_ENG_FACULA|MEM_ENG_VERT_VELOCITY|MEM_FINISH_DELAY|MEM_FOCUS_CONFIG|MEM_FOCUS_DEPTH|MEM_G0_ACC|MEM_G0_DELAY|MEM_G0_VELOCITY|MEM_HOME_VELOCITY|MEM_IO_ENABLE|MEM_LASER_MAX_POWER_1|MEM_LASER_MAX_POWER_2|MEM_LASER_MIN_POWER_1|MEM_LASER_MIN_POWER_2|MEM_LASER_PWM_FREQUENCY_1|MEM_LASER_PWM_FREQUENCY_2|MEM_LASER_STANDBY_FREQUENCY_1|MEM_LASER_STANDBY_FREQUENCY_2|MEM_LASER_STANDBY_PULSE_1|MEM_LASER_STANDBY_PULSE_2|MEM_MANUAL_FAST_SPEED|MEM_MANUAL_SLOW_SPEED|MEM_RESET_DELAY|MEM_ROTATE_D|MEM_ROTATE_PULSE|MEM_STATUS_OFF_DELAY|MEM_STATUS_ON_DELAY|MEM_SYSTEM_CONTROL_MODE|MEM_USER_PARA_1|MEM_U_HOME_VELOCITY_ALT|MEM_U_WORK_VELOCITY_ALT|MEM_X_DOCKING_POSITION|MEM_X_ENG_ACC|MEM_X_MINIMUM_ENG_VELOCITY|MEM_Y_DOCKING_POSITION|MEM_Y_ENG_ACC|MEM_Y_MINIMUM_ENG_VELOCITY|MEM_Z_HOME_VELOCITY_ALT|MEM_Z_WORK_VELOCITY_ALT|MOVE_FAR_XY|OVERSCAN_H_BI|OVERSCAN_H_UNI|OVERSCAN_OFF|OVERSCAN_V_BI|OVERSCAN_V_UNI|REF_POINT_CURRENT|REF_POINT_MACHINE|REF_POINT_ORIGIN|SELECT_LAYER|START_JOB)\\b",
      "name": "support.function.verified.rpascript"
    }
  }
}
